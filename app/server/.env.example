# pnpm --filter @localvault/server dev が読み込む開発用設定（コピーして .env にする）。
# 先に DB を起動: docker compose -f platform/docker/compose.dev.yml up -d db
DATABASE_URL=postgres://localvault:localvault@127.0.0.1:5432/localvault
PUBLIC_ORIGIN=http://localhost:8787
TOKEN_SECRET=dev-only-token-secret-0123456789abcdef0123456789abcdef
PRELOGIN_SECRET=dev-only-prelogin-secret-0123456789abcdef0123456789
REGISTRATION_MODE=open
TRUST_PROXY=0
LOG_LEVEL=debug
