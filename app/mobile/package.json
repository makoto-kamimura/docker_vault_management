    "expo-document-picker": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-haptics": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-notifications": "~58.1.0",
    "expo-print": "~58.0.0",
