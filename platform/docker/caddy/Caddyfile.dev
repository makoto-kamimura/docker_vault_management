# 開発用 Caddyfile。Caddy の内部 CA で署名した証明書を使う（tls internal）。
{
	local_certs
	auto_https disable_redirects
	skip_install_trust
}

https://localhost:8443 {
	tls internal

	request_body {
		max_size 13MB
	}

	log {
		output stdout
		format filter {
			wrap json
			request>headers delete
			request>uri regexp `\?.*` ""
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			resp_headers delete
		}
	}

	reverse_proxy app:8787
}
