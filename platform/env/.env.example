# LocalVault 本番用の設定。init-secrets.sh が .env としてコピーします。
# 秘密値（DB パスワード・トークン署名鍵など）はここではなく platform/secrets/ に置きます。

# 公開するドメイン名（DNS の A/AAAA レコードをこのサーバーに向けておく）
LV_DOMAIN=vault.example.net

# 公開 URL（https:// + 上のドメイン）
PUBLIC_ORIGIN=https://vault.example.net

# 登録モード: invite（招待制・既定）/ closed（登録停止）/ open（誰でも登録可）
REGISTRATION_MODE=invite

# ログの詳細度: debug / info / warn / error
LOG_LEVEL=info

# app / backup コンテナを動かす UID/GID（init-secrets.sh が自動で書き込みます）
LV_UID=1000
LV_GID=1000

# --- バックアップ ---
# 実行時刻（UTC の時）。18 = 日本時間の 3:00
BACKUP_HOUR_UTC=18
# 保持日数
BACKUP_KEEP_DAYS=14
# 1 にすると backup コンテナ起動時にも一度バックアップを取る
BACKUP_ON_START=0
# バックアップを暗号化する場合、パスフレーズファイルのパスを指定する
# （compose.yml からの相対パスまたは絶対パス。未設定なら暗号化なし）
# LV_BACKUP_PASSPHRASE_FILE=../secrets/backup_passphrase

# --- プッシュ通知（任意） ---
APNS_KEY_ID=
APNS_TEAM_ID=
# .p8 の中身（改行は \n ではなく実際の改行、または server の対応形式で）
APNS_KEY_P8=
# アプリの Bundle ID
APNS_TOPIC=
APNS_PRODUCTION=true
# FCM のサービスアカウント JSON（1 行に整形したもの）
FCM_SERVICE_ACCOUNT_JSON=
